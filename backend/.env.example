APP_NAME="Prelegal API"
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]
# Temporary SQLite database, recreated empty on every start
DATABASE_PATH=prelegal.db
# Built frontend (cd frontend && npm run build); served at / when it exists
STATIC_DIR=../frontend/out
# AI chat (OpenRouter -> Cerebras). Usually set in the repo-root .env instead.
OPENROUTER_API_KEY=
